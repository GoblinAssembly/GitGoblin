{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitGoblin",
  "version": "0.1.13",
  "identifier": "dev.gitgoblin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "GitGoblin",
        "decorations": false,
        "width": 1500,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 650,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:* ws://[::1]:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A Git workbench with shared T3 Code conversations",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxMTQxMDVCMzlCQkY2MUUKUldRZTlyczVXeEFVa1JpU2s5VHJsZ3g0VnBwVG1LL2tvUEg2MS84UENQcE90eXhtUDNxLy80Yi8K",
      "endpoints": [
        "https://github.com/GoblinAssembly/GitGoblin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
